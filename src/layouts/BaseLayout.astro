---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/noto-sans';
import '@fontsource/noto-sans-sc'; // 简体中文（400，备用）
import '@fontsource/noto-sans-sc/500.css'; // 中文正文主用（Medium，400 偏细）
import '@fontsource/noto-sans-sc/700.css'; // 中文加粗
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const siteTitle = lang === 'zh' ? '开启微观宇宙' : SITE.title;
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Favicon 套件（RealFaviconGenerator） -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#210a35" />

    <!-- 得意黑 Smiley Sans（中文标题）— cn-font-split 分块子集，按需加载 -->
    <link rel="stylesheet" href="/fonts/smiley-sans/result.css" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={SITE.url} />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'zh' ? '跳到主内容' : 'Skip to content'}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
