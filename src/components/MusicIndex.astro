---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getSection, getSubSection, secLabel, secName, secBlurb, subLabel, subBlurb, formatDate,
} from '../config/site';
import { getEvents, type MusicEvent } from '../lib/music-events';
import { getLangFromUrl, useTranslations, localizedHref } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const section = getSection('music')!;
const accent = section.accent;
const sep = lang === 'zh' ? '：' : ': ';

const upcoming = await getEvents('upcoming');
const past = await getEvents('past');
const PAGE = 10;

// per-language field pickers (fall back to the other language when empty)
const pick = (zh: string, en: string) => (lang === 'zh' ? zh || en : en || zh);
const evTitle = (e: MusicEvent) => pick(e.titleZh, e.titleEn);
const evLoc = (e: MusicEvent) => pick(e.locationZh, e.locationEn);
const evAddr = (e: MusicEvent) => pick(e.addressZh, e.addressEn);
const evDesc = (e: MusicEvent) => pick(e.descriptionZh, e.descriptionEn);
const evCat = (e: MusicEvent) => {
  const found = getSubSection('music', e.category);
  return found ? subLabel(found.sub, lang) : e.category;
};

const EN_MON = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
function dateBox(iso: string) {
  const [y, m, d] = iso.split('-');
  return { mon: lang === 'zh' ? `${Number(m)}月` : EN_MON[Number(m) - 1], day: String(Number(d)), year: y };
}
function ytThumb(url: string): string | null {
  if (!url) return null;
  const m = url.match(/(?:v=|youtu\.be\/|shorts\/|embed\/)([A-Za-z0-9_-]{11})/);
  return m ? `https://img.youtube.com/vi/${m[1]}/hqdefault.jpg` : null;
}
---

<BaseLayout title={secName(section, lang)} description={secBlurb(section, lang)}>
  <section class="section-hero">
    <div class="container section-hero-grid">
      <div class="section-hero-text">
        <h1>{secLabel(section, lang)}</h1>
        <p class="lead"><strong>{secName(section, lang)}</strong>{sep}{secBlurb(section, lang)}</p>
      </div>
      <div class="section-hero-art">
        <img src={section.image} alt="" />
      </div>
    </div>
  </section>

  <!-- ===== subsections (above events, no heading) ===== -->
  <section class="section">
    <div class="container">
      <div class="sub-grid">
        {section.children.map((sub) => (
          <a class="card sub-card" href={localizedHref(`/${section.slug}/${sub.slug}`, lang)}>
            <h3>{subLabel(sub, lang)}</h3>
            <p>{subBlurb(sub, lang)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== events ===== -->
  <section class="section section--alt">
    <div class="container">
      <h2 class="block-head">{t('music.eventsHeading')}</h2>

      <div class="ev-wrap" data-music-events style={`--ev-accent:${accent}`}>
        <div class="ev-tabs" role="tablist">
          <button class="ev-tab is-active" data-ev-tab="upcoming">{t('music.upcoming')}</button>
          <button class="ev-tab" data-ev-tab="past">{t('music.past')}</button>
        </div>

        {[
          { key: 'upcoming', list: upcoming, empty: t('music.noUpcoming') },
          { key: 'past', list: past, empty: t('music.noPast') },
        ].map((panel) => (
          <div class="ev-panel" data-ev-panel={panel.key} hidden={panel.key === 'past'}>
            {panel.list.length === 0 ? (
              <p class="ev-empty">{panel.empty}</p>
            ) : (
              <>
                <ul class="ev-list">
                  {panel.list.map((e, i) => {
                    const box = dateBox(e.date);
                    const thumb = ytThumb(e.video);
                    return (
                      <li class:list={['ev', { 'is-hidden': i >= PAGE }]}>
                        <div class="ev-card">
                          {e.date && (
                            <div class="ev-date-box">
                              <span class="ev-mon">{box.mon}</span>
                              <span class="ev-day">{box.day}</span>
                              <span class="ev-year">{box.year}</span>
                            </div>
                          )}
                          <div class="ev-content">
                            <div class="ev-meta">
                              <span class="ev-cat">{evCat(e)}</span>
                              {e.time && <span class="ev-time">{e.time}</span>}
                            </div>
                            <h3 class="ev-title">{evTitle(e)}</h3>
                            {evLoc(e) && <p class="ev-loc">{evLoc(e)}</p>}
                            {evAddr(e) && <p class="ev-addr">{evAddr(e)}</p>}
                            {evDesc(e) && <p class="ev-desc">{evDesc(e)}</p>}
                          </div>
                          {(thumb || e.video || e.eventLink) && (
                            <div class="ev-actions">
                              {thumb ? (
                                <a class="ev-thumb" href={e.video} target="_blank" rel="noopener" aria-label={t('music.video')}>
                                  <img src={thumb} alt="" loading="lazy" />
                                  <span class="ev-play" aria-hidden="true">▶</span>
                                </a>
                              ) : e.video ? (
                                <a class="btn btn--ghost ev-btn" href={e.video} target="_blank" rel="noopener">{t('music.video')}</a>
                              ) : null}
                              {e.eventLink && (
                                <a class="btn btn--ghost ev-btn" href={e.eventLink} target="_blank" rel="noopener">{t('music.info')}</a>
                              )}
                            </div>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ul>
                {panel.list.length > PAGE && (
                  <button class="btn btn--ghost ev-more" data-ev-more>{t('music.loadMore')}</button>
                )}
              </>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector('[data-music-events]');
  if (root) {
    const tabs = root.querySelectorAll('[data-ev-tab]');
    const panels = root.querySelectorAll('[data-ev-panel]');
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        const which = tab.getAttribute('data-ev-tab');
        tabs.forEach((tt) => tt.classList.toggle('is-active', tt === tab));
        panels.forEach((p) => {
          (p as HTMLElement).hidden = p.getAttribute('data-ev-panel') !== which;
        });
      }),
    );
    root.querySelectorAll('[data-ev-more]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const list = btn.previousElementSibling;
        if (!list) return;
        [...list.querySelectorAll('.ev.is-hidden')].slice(0, 10).forEach((li) => li.classList.remove('is-hidden'));
        if (!list.querySelector('.ev.is-hidden')) (btn as HTMLElement).hidden = true;
      });
    });
  }
</script>

<style>
  /* —— section hero (shared look with SectionIndex) —— */
  .section-hero {
    padding-block: 48px 28px;
    background: var(--c-hero);
    border-bottom: 1px solid var(--c-border);
  }
  .section-hero-grid {
    display: grid;
    grid-template-columns: 1fr 0.92fr;
    align-items: center;
    gap: 32px;
  }
  .section-hero-art img { width: 100%; height: auto; }
  .lead { font-family: var(--font-display); font-size: 1.05rem; color: var(--c-muted); max-width: 40em; }
  .lead strong { color: var(--c-ink); font-weight: 700; }

  .block-head { font-size: 1.4rem; margin: 0 0 18px; }

  /* —— subsection cards —— */
  .sub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 24px;
  }
  .sub-card { display: flex; flex-direction: column; padding: 26px; color: var(--c-text); }
  .sub-card h3 { margin-bottom: 8px; }
  .sub-card p { color: var(--c-muted); font-size: 0.95rem; margin: 0; }

  /* —— events: slider toggle (kept) —— */
  .ev-tabs { display: inline-flex; gap: 6px; padding: 4px; background: #fff; border: 1px solid var(--c-border); border-radius: 999px; margin-bottom: 22px; }
  .ev-tab {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 7px 18px;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--c-muted);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .ev-tab:hover { color: var(--c-ink); }
  .ev-tab.is-active { background: var(--ev-accent); color: #fff; }

  .ev-empty { color: var(--c-muted); }

  /* —— event cards —— */
  .ev-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .ev.is-hidden { display: none; }
  .ev-card {
    display: flex;
    gap: 22px;
    align-items: flex-start;
    padding: 22px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 18px;
    box-shadow: var(--shadow-sm);
  }

  .ev-date-box {
    flex: 0 0 auto;
    width: 76px;
    background: var(--c-hero);
    color: var(--c-ink);
    border-radius: 14px;
    padding: 12px 6px;
    text-align: center;
    font-family: var(--font-sans);
  }
  .ev-mon { display: block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-ink); }
  .ev-day { display: block; font-size: 1.8rem; font-weight: 800; line-height: 1.1; }
  .ev-year { display: block; font-size: 0.72rem; color: var(--c-muted); }

  .ev-content { flex: 1 1 auto; min-width: 0; }
  .ev-meta { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; }
  .ev-cat {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 600;
    color: #fff;
    background: var(--ev-accent);
    padding: 3px 10px;
    border-radius: 999px;
  }
  .ev-time { font-size: 0.85rem; color: var(--c-muted); }
  .ev-title { font-size: 1.15rem; margin: 0 0 6px; line-height: 1.25; }
  .ev-loc { color: var(--c-ink); font-weight: 600; font-size: 0.95rem; margin: 0; }
  .ev-addr { color: var(--c-muted); font-size: 0.85rem; margin: 2px 0 0; }
  .ev-desc { color: var(--c-muted); font-size: 0.9rem; line-height: 1.55; margin: 12px 0 0; }

  .ev-actions { flex: 0 0 auto; width: 188px; display: flex; flex-direction: column; gap: 10px; }
  .ev-thumb { position: relative; display: block; border-radius: 10px; overflow: hidden; aspect-ratio: 16 / 9; background: var(--c-bg-alt); }
  .ev-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ev-play {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 1.5rem; background: rgba(33, 10, 53, 0.28); transition: background 0.18s ease;
  }
  .ev-thumb:hover .ev-play { background: rgba(33, 10, 53, 0.12); }
  .ev-btn { padding: 9px 16px; font-size: 0.85rem; justify-content: center; }
  .ev-more { margin-top: 24px; }

  @media (max-width: 760px) {
    .section-hero-grid { grid-template-columns: 1fr; gap: 20px; }
    .section-hero-art { max-width: 380px; }
    .ev-card { flex-wrap: wrap; gap: 16px; }
    .ev-actions { width: 100%; flex-direction: row; }
    .ev-thumb { width: 180px; }
    .ev-btn { flex: 1; }
  }
</style>
