---
import { Icon } from 'astro-icon/components';
import {
  SECTIONS, getSection, getSocials, formatDate,
  secLabel, secName, secBlurb, subLabel,
} from '../config/site';
import { getLangFromUrl, useTranslations, localizedHref } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const socials = getSocials(lang);

// —— Latest updates (placeholder data; per-language sample titles) ——
const latestByLang = {
  en: [
    { title: 'sample: the title of a long-form tech research post', section: 'tech', date: '2026-06-01', href: '/tech/writings' },
    { title: 'sample: translation analysis of a spell in harry potter', section: 'linguistics', date: '2026-05-20', href: '/linguistics/analysis' },
    { title: 'sample: live video from a choir performance', section: 'music', date: '2026-05-08', href: '/music/choir' },
  ],
  zh: [
    { title: '示例：一篇技术长文研究的标题', section: 'tech', date: '2026-06-01', href: '/tech/writings' },
    { title: '示例：哈利波特里一个咒语的翻译分析', section: 'linguistics', date: '2026-05-20', href: '/linguistics/analysis' },
    { title: '示例：一场合唱演出的现场视频', section: 'music', date: '2026-05-08', href: '/music/choir' },
  ],
};
const latest = latestByLang[lang];

const slogan = t('home.slogan');
---

<!-- ===================== Hero ===================== -->
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-text">
      <h1 class="hero-title" set:html={t('home.heroTitle').replace(/\n/g, '<br />')} />
      <p class="hero-intro" set:html={t('home.heroIntro')} />
      <div class="hero-actions">
        <a class="btn btn--primary" href={localizedHref('/about', lang)}>{t('home.ctaAbout')}</a>
        <a class="btn btn--ghost" href="#sections">{t('home.ctaExplore')}</a>
      </div>
      <div class="hero-socials">
        {socials.map((s) => (
          <a class="social-link" href={s.href} aria-label={s.label}>
            <Icon name={s.icon} />
          </a>
        ))}
      </div>
    </div>
    <div class="hero-visual">
      <svg class="hero-blob" viewBox="0 0 180 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M16,52 C19,41 131,12 150,18 C169,24 154,80 132,86 C110,92 13,63 16,52 Z" fill="#e3d3f5" />
      </svg>
      <img src="/images/hero.svg" alt="" />
    </div>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span>{slogan.repeat(2)}</span>
      <span>{slogan.repeat(2)}</span>
    </div>
  </div>
</section>

<!-- ===================== Sections ===================== -->
<section class="section section--alt" id="sections">
  <div class="container">
    <span class="eyebrow">{t('home.sectionsEyebrow')}</span>
    <h2>{t('home.sectionsHeading')}</h2>
    <div class="sections-grid">
      {
        SECTIONS.map((section) => (
          <a class="card section-card" href={localizedHref(`/${section.slug}`, lang)} data-pos={section.imagePos} style={`border-top-color:${section.accent}`}>
            <div class="section-card-body">
              <h3>{secLabel(section, lang)}</h3>
              <span class="card-chip" style={`background:${section.accent}`}>{secName(section, lang)}</span>
              <p>{secBlurb(section, lang)}</p>
              <div class="section-tags">
                {section.children.map((c) => (
                  <span class="tag">{subLabel(c, lang)}</span>
                ))}
              </div>
            </div>
            <img class="section-card-art" src={section.image} alt="" />
          </a>
        ))
      }
    </div>
  </div>
</section>

<!-- ===================== Latest ===================== -->
<section class="section">
  <div class="container">
    <span class="eyebrow">{t('home.latestEyebrow')}</span>
    <h2>{t('home.latestHeading')}</h2>
    <ul class="updates">
      {
        latest.map((item) => {
          const sec = getSection(item.section)!;
          return (
            <li>
              <a class="update-row" href={localizedHref(item.href, lang)}>
                <span class="update-tag" style={`background:${sec.accent}`}>{secName(sec, lang)}</span>
                <span class="update-title">{item.title}</span>
                <time class="update-date">{formatDate(item.date, lang)}</time>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="latest-note">{t('home.latestNote')}</p>
  </div>
</section>

<style>
  /* —— Hero —— */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--c-hero);
    padding-bottom: 6px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    align-items: center;
    gap: 40px;
    padding-block: 64px 52px;
  }
  .hero-visual {
    position: relative;
  }
  .hero-blob {
    position: absolute;
    inset: -16% -12%;
    z-index: 0;
  }
  .hero-visual img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
  }
  .hero-title {
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.05;
    margin-bottom: 22px;
    max-width: 14em;
  }
  .hero-intro {
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 400;
    color: var(--c-text);
    max-width: 36em;
    margin-bottom: 28px;
  }
  .hero-intro :global(strong) { color: var(--c-ink); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-socials { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 26px; }
  .social-link {
    display: inline-flex;
    align-items: center;
    color: var(--c-ink);
    transition: color 0.18s ease, transform 0.18s ease;
  }
  .social-link:hover { color: var(--c-purple); transform: translateY(-2px); }
  .social-link :global(svg) { width: 24px; height: 24px; }

  /* —— Big slogan strip —— */
  .marquee {
    overflow: hidden;
    width: 100%;
    border-top: 1px solid var(--c-border);
    padding-block: 14px;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee__track span {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.4rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--c-slogan);
    white-space: nowrap;
  }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  /* —— section cards —— */
  .sections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 32px;
  }
  .section-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 30px;
    min-height: 300px;
    color: var(--c-text);
    border-top: 3px solid var(--c-border);
  }
  .section-card-body { position: relative; z-index: 1; }
  .section-card-art {
    position: absolute;
    width: 120%;
    opacity: 0.22;
    pointer-events: none;
    z-index: 0;
  }
  .section-card[data-pos="left"] .section-card-art { left: -22%; bottom: 2%; }
  .section-card[data-pos="right"] .section-card-art { right: -22%; bottom: 2%; }
  .section-card[data-pos="center"] .section-card-art { left: 50%; top: 50%; transform: translate(-50%, -50%); }
  .section-card h3 { margin-bottom: 6px; font-size: 1.5rem; }
  .card-chip {
    display: inline-block;
    margin: 0 0 14px;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    padding: 3px 9px;
    border-radius: 999px;
  }
  .section-card p {
    font-family: var(--font-display);
    color: var(--c-ink);
    font-weight: 400;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }
  .section-tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 18px 0 0; }
  .tag {
    font-family: var(--font-display);
    font-size: 0.72rem;
    color: var(--c-purple);
    background: var(--c-bg-alt);
    border: 1px solid var(--c-border);
    padding: 4px 10px;
    border-radius: 999px;
  }

  /* —— recent updates —— */
  .updates {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    border-top: 1px solid var(--c-border);
  }
  .update-row {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 6px;
    border-bottom: 1px solid var(--c-border);
    color: var(--c-text);
    transition: background 0.15s ease;
  }
  .update-row:hover { background: var(--c-bg-alt); }
  .update-tag {
    flex: 0 0 auto;
    min-width: 96px;
    text-align: center;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .update-title { flex: 1 1 auto; font-weight: 600; color: var(--c-ink); }
  .update-date { flex: 0 0 auto; font-size: 0.85rem; color: var(--c-muted); }
  .latest-note { color: var(--c-muted); font-size: 0.85rem; margin-top: 18px; }

  /* —— responsive —— */
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 28px; padding-block: 40px; }
    .sections-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .update-row { flex-wrap: wrap; gap: 8px 12px; }
    .update-date { width: 100%; }
  }
</style>
