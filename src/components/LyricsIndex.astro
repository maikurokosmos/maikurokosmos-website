---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSubSection, secLabel, subLabel, subBlurb, formatDate } from '../config/site';
import { lyricsTags } from '../config/lyrics';
import { getLyricsWorks } from '../lib/lyrics-content';
import { getLangFromUrl, useTranslations, localizedHref } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { section, sub } = getSubSection('music', 'lyrics-attempts')!;

const works = await getLyricsWorks(lang);
---

<BaseLayout title={`${subLabel(sub, lang)} · ${secLabel(section, lang)}`} description={subBlurb(sub, lang)}>
  <section class="ly">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={localizedHref('/', lang)}>{t('crumb.home')}</a><span aria-hidden="true">/</span>
        <a href={localizedHref(`/${section.slug}`, lang)}>{secLabel(section, lang)}</a><span aria-hidden="true">/</span>
        <span aria-current="page">{subLabel(sub, lang)}</span>
      </nav>

      <h1>{subLabel(sub, lang)}</h1>

      {works.length === 0 ? (
        <p class="empty">{t('lyrics.empty')}</p>
      ) : (
        <ul class="works">
          {works.map((w) => (
            <li>
              <a class="work-row" href={localizedHref(`/music/lyrics-attempts/${w.data.key}`, lang)}>
                <div class="work-main">
                  <span class="work-headline">
                    <span class="work-title">{w.data.title}</span>
                  </span>
                  <time class="work-date" datetime={w.data.date}>{formatDate(w.data.date, lang)}</time>
                </div>
                {w.data.original && <p class="work-original">{w.data.original}</p>}
                <div class="tag-row work-tags">
                  {lyricsTags(w.data.type, w.data.languages, lang).map((tg) => <span class="tag">{tg}</span>)}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .ly { padding-block: 56px; }
  .crumbs { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 0.88rem; color: var(--c-muted); margin-bottom: 20px; }
  .crumbs a { color: var(--c-muted); }
  .crumbs a:hover { color: var(--c-purple); }
  h1 { margin-bottom: 32px; }
  .empty { color: var(--c-muted); }

  .tag-row { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.7rem;
    color: var(--c-purple);
    background: var(--c-bg-alt);
    border: 1px solid var(--c-border);
    padding: 3px 9px;
    border-radius: 999px;
  }

  .works { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--c-border); }
  .work-row {
    display: block;
    padding: 18px 6px;
    border-bottom: 1px solid var(--c-border);
    color: var(--c-text);
    transition: background 0.15s ease;
  }
  .work-row:hover { background: var(--c-bg-alt); }
  .work-main { display: flex; align-items: baseline; gap: 16px; }
  .work-headline { flex: 1 1 auto; min-width: 0; display: inline-flex; align-items: center; gap: 10px; }
  .work-title { font-weight: 700; color: var(--c-ink); font-size: 1.08rem; }
  .work-date { flex: 0 0 auto; font-size: 0.85rem; color: var(--c-muted); font-variant-numeric: tabular-nums; }
  .work-original { margin: 4px 0 0; font-size: 0.85rem; color: var(--c-purple); }
  .work-tags { margin: 10px 0 0; }

  @media (max-width: 640px) {
    .work-main { flex-wrap: wrap; gap: 4px; }
    .work-date { width: 100%; }
  }
</style>
