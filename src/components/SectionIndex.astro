---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSection } from '../config/site';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const section = getSection(slug);
if (!section) throw new Error(`未知板块：${slug}`);
---

<BaseLayout title={section.name} description={section.blurb}>
  <section class="section-hero">
    <div class="container">
      <h1>{section.label}</h1>
      <p class="lead"><strong>{section.name}</strong>: {section.blurb}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sub-grid">
        {
          section.children.map((sub) => (
            <a class="card sub-card" href={`/${section.slug}/${sub.slug}`}>
              <h3>{sub.label}</h3>
              <p>{sub.blurb}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-hero {
    padding-block: 64px 28px;
    background: var(--c-hero);
    border-bottom: 1px solid var(--c-border);
  }
  .lead { font-family: var(--font-display); font-size: 1.05rem; color: var(--c-muted); max-width: 46em; }
  .lead strong { color: var(--c-ink); font-weight: 700; }

  .sub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
  }
  .sub-card { display: flex; flex-direction: column; padding: 26px; color: var(--c-text); }
  .sub-card h3 { margin-bottom: 8px; }
  .sub-card p { color: var(--c-muted); font-size: 0.95rem; margin: 0; }
</style>
