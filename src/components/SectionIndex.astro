---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSection } from '../config/site';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const section = getSection(slug);
if (!section) throw new Error(`未知板块：${slug}`);
---

<BaseLayout title={section.label} description={section.blurb}>
  <section class="section-hero">
    <div class="container">
      <h1>{section.label}</h1>
      <p class="lead">{section.blurb}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Subsections</h2>
      <div class="sub-grid">
        {
          section.children.map((sub) => (
            <a class="card sub-card" href={`/${section.slug}/${sub.slug}`}>
              <h3>{sub.label}</h3>
              <p>{sub.blurb}</p>
              <span class="sub-link" style={`color:${section.accent}`}>View →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-hero {
    padding-block: 64px 28px;
    background: var(--c-hero);
    border-bottom: 1px solid var(--c-border);
  }
  .lead { font-size: 1.15rem; color: var(--c-muted); max-width: 40em; }

  .sub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
    margin-top: 24px;
  }
  .sub-card { display: flex; flex-direction: column; padding: 26px; color: var(--c-text); }
  .sub-card h3 { margin-bottom: 8px; }
  .sub-card p { color: var(--c-muted); font-size: 0.95rem; }
  .sub-link { margin-top: 16px; font-weight: 600; font-size: 0.9rem; }
</style>
