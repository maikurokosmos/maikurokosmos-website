---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSection } from '../config/site';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const section = getSection(slug);
if (!section) throw new Error(`未知板块：${slug}`);
---

<BaseLayout title={section.name} description={section.blurb}>
  <section class="section-hero">
    <div class="container section-hero-grid">
      <div class="section-hero-text">
        <h1>{section.label}</h1>
        <p class="lead"><strong>{section.name}</strong>: {section.blurb}</p>
      </div>
      <div class="section-hero-art">
        <img src={section.image} alt="" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sub-grid">
        {
          section.children.map((sub) => (
            <a class="card sub-card" href={`/${section.slug}/${sub.slug}`}>
              <h3>{sub.label}</h3>
              <p>{sub.blurb}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-hero {
    padding-block: 48px 28px;
    background: var(--c-hero);
    border-bottom: 1px solid var(--c-border);
  }
  .section-hero-grid {
    display: grid;
    grid-template-columns: 1fr 0.92fr;
    align-items: center;
    gap: 32px;
  }
  .section-hero-art img { width: 100%; height: auto; }
  .lead { font-family: var(--font-display); font-size: 1.05rem; color: var(--c-muted); max-width: 40em; }
  .lead strong { color: var(--c-ink); font-weight: 700; }

  @media (max-width: 760px) {
    .section-hero-grid { grid-template-columns: 1fr; gap: 20px; }
    .section-hero-art { max-width: 380px; }
  }

  .sub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
  }
  .sub-card { display: flex; flex-direction: column; padding: 26px; color: var(--c-text); }
  .sub-card h3 { margin-bottom: 8px; }
  .sub-card p { color: var(--c-muted); font-size: 0.95rem; margin: 0; }
</style>
