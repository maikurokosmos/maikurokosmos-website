---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSubSection } from '../config/site';

interface Props {
  sectionSlug: string;
  subSlug: string;
}

const { sectionSlug, subSlug } = Astro.props;
const found = getSubSection(sectionSlug, subSlug);
if (!found) throw new Error(`Unknown subsection: ${sectionSlug}/${subSlug}`);
const { section, sub } = found;
---

<BaseLayout title={`${sub.label} · ${section.label}`} description={sub.blurb}>
  <section class="ph">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href={`/${section.slug}`}>{section.label}</a>
        <span>/</span>
        <span aria-current="page">{sub.label}</span>
      </nav>

      <h1>{sub.label}</h1>
      <p class="lead">{sub.blurb}</p>

      <div class="card ph-card" style={`--accent:${section.accent}`}>
        <span class="ph-badge" style={`background:${section.accent}`}>Coming soon</span>
        <p>This subsection is being prepared. Posts and works will appear here once published.</p>
        <a class="btn btn--ghost" href={`/${section.slug}`}>← Back to {section.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ph { padding-block: 56px; }
  .crumbs {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 0.88rem;
    color: var(--c-muted);
    margin-bottom: 20px;
  }
  .crumbs a { color: var(--c-muted); }
  .crumbs a:hover { color: var(--c-purple); }
  .lead { font-size: 1.1rem; color: var(--c-muted); max-width: 40em; }

  .ph-card {
    margin-top: 28px;
    padding: 36px;
    max-width: 560px;
    border-top: 3px solid var(--accent);
  }
  .ph-badge {
    display: inline-block;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 16px;
  }
  .ph-card p { color: var(--c-muted); margin-bottom: 22px; }
</style>
