---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSubSection, secLabel, subLabel, subBlurb } from '../config/site';
import { getLangFromUrl, useTranslations, localizedHref } from '../i18n/utils';

interface Props {
  sectionSlug: string;
  subSlug: string;
}

const { sectionSlug, subSlug } = Astro.props;
const found = getSubSection(sectionSlug, subSlug);
if (!found) throw new Error(`Unknown subsection: ${sectionSlug}/${subSlug}`);
const { section, sub } = found;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`${subLabel(sub, lang)} · ${secLabel(section, lang)}`} description={subBlurb(sub, lang)}>
  <section class="ph">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={localizedHref('/', lang)}>{t('crumb.home')}</a>
        <span>/</span>
        <a href={localizedHref(`/${section.slug}`, lang)}>{secLabel(section, lang)}</a>
        <span>/</span>
        <span aria-current="page">{subLabel(sub, lang)}</span>
      </nav>

      <h1>{subLabel(sub, lang)}</h1>
      <p class="lead">{subBlurb(sub, lang)}</p>

      <div class="card ph-card" style={`--accent:${section.accent}`}>
        <span class="ph-badge" style={`background:${section.accent}`}>{t('common.comingSoon')}</span>
        <p>{t('ph.body')}</p>
        <a class="btn btn--ghost" href={localizedHref(`/${section.slug}`, lang)}>← {t('ph.back')} {secLabel(section, lang)}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ph { padding-block: 56px; }
  .crumbs {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 0.88rem;
    color: var(--c-muted);
    margin-bottom: 20px;
  }
  .crumbs a { color: var(--c-muted); }
  .crumbs a:hover { color: var(--c-purple); }
  .lead { font-size: 1.1rem; color: var(--c-muted); max-width: 40em; }

  .ph-card {
    margin-top: 28px;
    padding: 36px;
    max-width: 560px;
    border-top: 3px solid var(--accent);
  }
  .ph-badge {
    display: inline-block;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 16px;
  }
  .ph-card p { color: var(--c-muted); margin-bottom: 22px; }
</style>
