---
import { SECTIONS } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/images/logo-dark.svg" alt="maikurokosmos" height="28" />
      <p>Tech · Linguistics · Music</p>
    </div>

    <nav class="footer-nav" aria-label="页脚导航">
      {
        SECTIONS.map((section) => (
          <div class="footer-col">
            <a class="footer-head" href={`/${section.slug}`}>{section.label}</a>
            <ul>
              {section.children.map((child) => (
                <li>
                  <a href={`/${section.slug}/${child.slug}`}>{child.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="footer-col">
        <a class="footer-head" href="/about">About</a>
      </div>
    </nav>
  </div>

  <div class="container footer-bottom">
    <span>© {year} maikurokosmos</span>
    <span>www.maikurokosmos.com</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-ink);
    color: rgba(255, 255, 255, 0.72);
    margin-top: 80px;
    padding-block: 56px 28px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 48px;
  }
  .footer-brand img { width: auto; margin-bottom: 14px; }
  .footer-brand p {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.04em;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .footer-head {
    display: inline-block;
    color: #fff;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .footer-head:hover { color: var(--c-pink); }
  .footer-col ul { list-style: none; margin: 0; padding: 0; }
  .footer-col li { margin-bottom: 8px; }
  .footer-col a {
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.9rem;
  }
  .footer-col a:hover { color: #fff; }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr; gap: 32px; }
    .footer-nav { grid-template-columns: repeat(2, 1fr); }
    .footer-bottom { flex-direction: column; gap: 8px; text-align: center; }
  }
</style>
