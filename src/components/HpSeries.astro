---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getSection, secLabel } from '../config/site';
import { HP_SERIES, HP_BOOKS } from '../config/harry-potter';
import { getLangFromUrl, useTranslations, localizedHref } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const section = getSection('linguistics')!;
const seriesTitle = lang === 'zh' ? HP_SERIES.titleZh : HP_SERIES.titleEn;

const PREFERRED_LANG = lang;
type Entry = CollectionEntry<'harryPotter'>;
function pickLang(group: Entry[]): Entry {
  return group.find((e) => e.data.lang === PREFERRED_LANG) ?? group[0];
}

const all = (await getCollection('harryPotter')).filter((e) => !e.data.draft);

const seriesIntroGroup = all.filter((e) => e.data.kind === 'series-intro');
const seriesIntroEntry = seriesIntroGroup.length ? pickLang(seriesIntroGroup) : null;
const SeriesIntro = seriesIntroEntry ? (await render(seriesIntroEntry)).Content : null;

const booksView = HP_BOOKS.map((book) => {
  const entries = all.filter(
    (e) => e.data.book === book.slug && (e.data.kind === 'book-intro' || e.data.kind === 'chapter'),
  );
  const byKey = new Map<string, Entry[]>();
  for (const e of entries) {
    const list = byKey.get(e.data.key) ?? [];
    list.push(e);
    byKey.set(e.data.key, list);
  }
  const items = [...byKey.values()]
    .map((group) => {
      const e = pickLang(group);
      return { key: e.data.key, title: e.data.title, kind: e.data.kind, order: e.data.order };
    })
    .sort((a, b) => a.order - b.order);
  return { ...book, items };
});
---

<BaseLayout title={seriesTitle} description={lang === 'zh' ? '用语言学的视角细读哈利·波特' : 'a close reading of harry potter through the lens of linguistics'}>
  <section class="hp-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={localizedHref('/', lang)}>{t('crumb.home')}</a><span aria-hidden="true">/</span>
        <a href={localizedHref('/linguistics', lang)}>{secLabel(section, lang)}</a><span aria-hidden="true">/</span>
        <a href={localizedHref('/linguistics/readings', lang)}>{t('readings.title')}</a><span aria-hidden="true">/</span>
        <span aria-current="page">harry potter</span>
      </nav>
      <span class="eyebrow">{t('hp.readingSeries')}</span>
      <h1 class="hp-title">{seriesTitle}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container hp-wrap">
      {SeriesIntro && (
        <div class="prose hp-intro">
          <SeriesIntro />
        </div>
      )}

      <h2 class="hp-books-head">{t('hp.books')}</h2>
      <div class="hp-books">
        {booksView.map((book) => {
          const bookTitle = lang === 'zh' ? book.titleZh : book.titleEn;
          return (
            <details class="hp-book" open={book.items.length > 0 && book.order === 1}>
              <summary class="hp-summary">
                <span class="hp-no">{String(book.order).padStart(2, '0')}</span>
                <span class="hp-name">{bookTitle}</span>
                <span class="hp-plus" aria-hidden="true"></span>
              </summary>
              {book.items.length === 0 ? (
                <p class="hp-empty">{t('common.comingSoon')}</p>
              ) : (
                <ul class="hp-chapters">
                  {book.items.map((it) => (
                    <li>
                      <a class="hp-chapter" href={localizedHref(`/linguistics/readings/${HP_SERIES.slug}/${book.slug}/${it.key}`, lang)}>
                        <svg class="hp-doc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                          <path d="M14 3v5h5" />
                          <line x1="9" y1="13" x2="15" y2="13" />
                          <line x1="9" y1="17" x2="13" y2="17" />
                        </svg>
                        <span class="hp-chapter-title">
                          {it.kind === 'book-intro'
                            ? t('hp.intro')
                            : lang === 'zh'
                              ? `第${it.order}章：${it.title}`
                              : `chapter ${it.order}: ${it.title}`}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </details>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hp-hero { background: var(--c-hero); padding-block: 44px 30px; border-bottom: 1px solid var(--c-border); }
  .crumbs { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 0.88rem; color: var(--c-muted); margin-bottom: 18px; }
  .crumbs a { color: var(--c-muted); }
  .crumbs a:hover { color: var(--c-purple); }
  .hp-title { font-size: clamp(1.6rem, 3.2vw, 2.4rem); line-height: 1.14; margin: 0; max-width: 18em; }

  .hp-wrap { max-width: 820px; }
  .hp-intro { margin-bottom: 36px; }

  .hp-books-head { font-size: 1.3rem; margin: 0 0 16px; }
  .hp-books { display: flex; flex-direction: column; gap: 12px; }

  .hp-book {
    border: 1px solid var(--c-border);
    border-radius: 14px;
    background: var(--c-surface);
    overflow: hidden;
  }
  .hp-summary {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
  }
  .hp-summary::-webkit-details-marker { display: none; }
  .hp-summary:hover { background: var(--c-bg-alt); }
  .hp-no { font-size: 0.8rem; color: var(--c-muted); font-variant-numeric: tabular-nums; }
  .hp-name { font-size: 1.05rem; color: var(--c-ink); font-weight: 700; }

  .hp-plus { margin-left: auto; position: relative; width: 18px; height: 18px; flex: 0 0 auto; }
  .hp-plus::before, .hp-plus::after { content: ''; position: absolute; background: var(--c-purple); border-radius: 2px; }
  .hp-plus::before { top: 8px; left: 1px; width: 16px; height: 2px; }
  .hp-plus::after { left: 8px; top: 1px; width: 2px; height: 16px; transition: opacity 0.15s ease; }
  .hp-book[open] .hp-plus::after { opacity: 0; }

  .hp-empty { padding: 4px 20px 18px 52px; color: var(--c-muted); font-size: 0.9rem; margin: 0; }
  .hp-chapters { list-style: none; margin: 0; padding: 0 12px 10px; }
  .hp-chapter {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 12px;
    border-radius: 10px;
    color: var(--c-text);
  }
  .hp-chapter:hover { background: var(--c-bg-alt); }
  .hp-doc { flex: 0 0 auto; width: 16px; height: 16px; color: var(--c-purple); }
  .hp-chapter-title { flex: 1 1 auto; }
</style>
