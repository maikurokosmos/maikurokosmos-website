---
// 文章里用的"提示 / 结论卡片"组件 —— 这类东西纯 Markdown 做不到，MDX 可以。
interface Props {
  type?: 'note' | 'tip' | 'warning' | 'conclusion';
  title?: string;
}
const { type = 'note', title } = Astro.props;
---

<aside class:list={['callout', `callout--${type}`]}>
  {title && <p class="callout-title">{title}</p>}
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    border-left: 4px solid var(--c-purple);
    background: var(--c-bg-alt);
    border-radius: 0 12px 12px 0;
    padding: 14px 20px;
    margin: 1.6em 0;
  }
  .callout--tip { border-left-color: var(--c-pink); }
  .callout--warning { border-left-color: #e0a500; }
  .callout--conclusion { border-left-color: var(--c-ink); background: var(--c-hero); }
  .callout-title { font-family: var(--font-display); font-weight: 700; color: var(--c-ink); margin: 0 0 6px; }
  /* slotted markdown comes from the .mdx file (different scope) → needs :global */
  .callout-body :global(p) { margin: 0.5em 0; }
  .callout-body :global(p:first-child) { margin-top: 0; }
  .callout-body :global(p:last-child) { margin-bottom: 0; }
</style>
