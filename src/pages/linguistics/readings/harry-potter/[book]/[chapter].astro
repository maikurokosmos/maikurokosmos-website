---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import HpChapter from '../../../../../components/HpChapter.astro';

export async function getStaticPaths() {
  const PREFERRED_LANG: 'en' | 'zh' = 'en';
  const all = await getCollection('harryPotter');
  type Entry = CollectionEntry<'harryPotter'>;
  const groups = new Map<string, Entry[]>();
  for (const e of all) {
    if (e.data.draft) continue;
    if (e.data.kind !== 'chapter' && e.data.kind !== 'book-intro') continue;
    if (!e.data.book) continue;
    const id = `${e.data.book}//${e.data.key}`;
    const list = groups.get(id) ?? [];
    list.push(e);
    groups.set(id, list);
  }
  return [...groups.values()].map((group) => {
    const e = group.find((x) => x.data.lang === PREFERRED_LANG) ?? group[0];
    return { params: { book: e.data.book!, chapter: e.data.key }, props: { entryId: e.id } };
  });
}

const { entryId } = Astro.props as { entryId: string };
---

<HpChapter entryId={entryId} />
