---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { SECTIONS, getSection, SOCIALS, formatDate } from '../config/site';

// —— Latest updates (placeholder data; will be replaced by real posts via Content Collections) ——
const latest = [
  { title: 'sample: the title of a long-form tech research post', section: 'tech', date: '2026-06-01', href: '/tech/writings' },
  { title: 'sample: translation analysis of a spell in harry potter', section: 'linguistics', date: '2026-05-20', href: '/linguistics/analysis' },
  { title: 'sample: live video from a choir performance', section: 'music', date: '2026-05-08', href: '/music/choir' },
];

// Big slogan repeated for the strip (static for now, motion-ready)
const slogan = 'AI CONTROL RESEARCH ✦ LINGUISTIC LEARNING & SHARING ✦ MUSIC PORTFOLIO ✦ ';
---

<BaseLayout>
  <!-- ===================== Hero ===================== -->
  <section class="hero">
    <div class="container hero-inner">
      <h1 class="hero-title">from sounds,<br />from text,<br />for human</h1>
      <p class="hero-intro">
        Hi, and welcome to Kaiyu's personal hub, <strong>“maikurokosmos”</strong>.
        I'm sharing a few things here: my independent research on
        <strong>AI safety and control</strong> (especially the bias embedded in
        AI), my learning in <strong>(socio-)linguistics</strong>, and my own work
        in <strong>music</strong>, including the events I take part in, the songs
        I cover, and the occasional music critique. Feel free to reach out, or
        follow me on my other social media!
      </p>
      <div class="hero-actions">
        <a class="btn btn--primary" href="/about">about me</a>
        <a class="btn btn--ghost" href="#sections">explore</a>
      </div>
      <div class="hero-socials">
        {SOCIALS.map((s) => (
          <a class="social-link" href={s.href} aria-label={s.label}>
            <Icon name={s.icon} />
          </a>
        ))}
      </div>
    </div>

    <!-- Big slogan strip — static now; flip on the animation later for a right-to-left marquee -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        <span>{slogan.repeat(2)}</span>
        <span>{slogan.repeat(2)}</span>
      </div>
    </div>
  </section>

  <!-- ===================== Sections ===================== -->
  <section class="section section--alt" id="sections">
    <div class="container">
      <span class="eyebrow">Sections</span>
      <h2>what's here</h2>
      <div class="sections-grid">
        {
          SECTIONS.map((section) => (
            <a class="card section-card" href={`/${section.slug}`} style={`border-top-color:${section.accent}`}>
              <h3>{section.label}</h3>
              <p><strong>{section.name}</strong>: {section.blurb}</p>
              <div class="section-tags">
                {section.children.map((c) => (
                  <span class="tag">{c.label}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== Latest ===================== -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">Latest</span>
      <h2>recent updates</h2>
      <ul class="updates">
        {
          latest.map((item) => {
            const sec = getSection(item.section)!;
            return (
              <li>
                <a class="update-row" href={item.href}>
                  <span class="update-tag" style={`background:${sec.accent}`}>{sec.name}</span>
                  <span class="update-title">{item.title}</span>
                  <time class="update-date">{formatDate(item.date)}</time>
                </a>
              </li>
            );
          })
        }
      </ul>
      <p class="latest-note">(Placeholder examples for now; real posts will appear here once published.)</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* —— Hero —— */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--c-hero);
    padding-bottom: 6px;
  }
  .hero-inner {
    padding-block: 84px 52px;
  }
  .hero-title {
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.05;
    margin-bottom: 22px;
    max-width: 14em;
  }
  .hero-intro {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--c-text);
    max-width: 36em;
    margin-bottom: 28px;
  }
  .hero-intro strong { color: var(--c-ink); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-socials { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 26px; }
  .social-link {
    display: inline-flex;
    align-items: center;
    color: var(--c-ink);
    transition: color 0.18s ease, transform 0.18s ease;
  }
  .social-link:hover { color: var(--c-purple); transform: translateY(-2px); }
  .social-link :global(svg) { width: 24px; height: 24px; }

  /* —— Big slogan strip (full-bleed). Static now; motion comes later. —— */
  .marquee {
    overflow: hidden;
    width: 100%;
    border-top: 1px solid var(--c-border);
    padding-block: 14px;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }
  /* pause on hover */
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee__track span {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.4rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--c-slogan);
    white-space: nowrap;
  }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  /* —— section cards (bigger; accent top border; ready for background art later) —— */
  .sections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 32px;
  }
  .section-card {
    display: flex;
    flex-direction: column;
    padding: 34px 32px;
    color: var(--c-text);
    border-top: 3px solid var(--c-border);
  }
  .section-card h3 { margin-bottom: 12px; font-size: 1.5rem; }
  .section-card p { color: var(--c-muted); font-size: 1rem; line-height: 1.6; margin: 0; }
  .section-card p strong { color: var(--c-ink); font-weight: 700; }
  .section-tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 18px 0 0; }
  .tag {
    font-family: var(--font-display);
    font-size: 0.72rem;
    color: var(--c-purple);
    background: var(--c-bg-alt);
    border: 1px solid var(--c-border);
    padding: 4px 10px;
    border-radius: 999px;
  }

  /* —— recent updates: list —— */
  .updates {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    border-top: 1px solid var(--c-border);
  }
  .update-row {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 6px;
    border-bottom: 1px solid var(--c-border);
    color: var(--c-text);
    transition: background 0.15s ease;
  }
  .update-row:hover { background: var(--c-bg-alt); }
  .update-tag {
    flex: 0 0 auto;
    min-width: 96px;
    text-align: center;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .update-title { flex: 1 1 auto; font-weight: 600; color: var(--c-ink); }
  .update-date { flex: 0 0 auto; font-size: 0.85rem; color: var(--c-muted); }
  .latest-note { color: var(--c-muted); font-size: 0.85rem; margin-top: 18px; }

  /* —— responsive —— */
  @media (max-width: 900px) {
    .hero-inner { padding-block: 52px 40px; }
    .sections-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .update-row { flex-wrap: wrap; gap: 8px 12px; }
    .update-date { width: 100%; }
  }
</style>
