---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTIONS, getSection } from '../config/site';

// —— Latest updates (placeholder data; will be replaced by real posts via Content Collections) ——
const latest = [
  { title: 'Sample: the title of a long-form tech research post', section: 'tech', date: '2026-06-01', href: '/tech/writings' },
  { title: 'Sample: translation analysis of a spell in Harry Potter', section: 'linguistics', date: '2026-05-20', href: '/linguistics/analysis' },
  { title: 'Sample: live video from a choir performance', section: 'music', date: '2026-05-08', href: '/music/choir' },
];

// Big slogan repeated for the strip (static for now, motion-ready)
const slogan = 'Tech / Linguistics / Music / ';
---

<BaseLayout>
  <!-- ===================== Hero ===================== -->
  <section class="hero">
    <div class="container hero-inner">
      <h1 class="hero-title">Research, language, and&nbsp;music.</h1>
      <p class="hero-intro">
        Hi, I'm <strong>maikurokosmos</strong>. I publish
        <strong>technical writing</strong> and datasets, study
        <strong>linguistics</strong>, and share the <strong>music</strong>
        I make and perform. Welcome — have a look around.
      </p>
      <div class="hero-actions">
        <a class="btn btn--primary" href="/about">About me →</a>
        <a class="btn btn--ghost" href="#sections">Explore</a>
      </div>
    </div>

    <!-- Big slogan strip — static now; flip on the animation later for a right-to-left marquee -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        <span>{slogan.repeat(4)}</span>
        <span>{slogan.repeat(4)}</span>
      </div>
    </div>
  </section>

  <!-- ===================== Sections ===================== -->
  <section class="section section--alt" id="sections">
    <div class="container">
      <span class="eyebrow">Sections</span>
      <h2>What's here</h2>
      <div class="sections-grid">
        {
          SECTIONS.map((section) => (
            <a class="card section-card" href={`/${section.slug}`} style={`border-top-color:${section.accent}`}>
              <h3>{section.label}</h3>
              <p>{section.blurb}</p>
              <div class="section-tags">
                {section.children.map((c) => (
                  <span class="tag">{c.label}</span>
                ))}
              </div>
              <span class="section-link" style={`color:${section.accent}`}>Enter →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== Latest ===================== -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">Latest</span>
      <h2>Recent updates</h2>
      <ul class="updates">
        {
          latest.map((item) => {
            const sec = getSection(item.section)!;
            return (
              <li>
                <a class="update-row" href={item.href}>
                  <span class="update-tag" style={`background:${sec.accent}`}>{sec.label}</span>
                  <span class="update-title">{item.title}</span>
                  <time class="update-date">{item.date}</time>
                </a>
              </li>
            );
          })
        }
      </ul>
      <p class="latest-note">(Placeholder examples — real posts will appear here once published.)</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* —— Hero —— */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--c-hero);
    padding-bottom: 6px;
  }
  .hero-inner {
    padding-block: 84px 52px;
  }
  .hero-title {
    font-size: clamp(2.8rem, 6vw, 4.6rem);
    line-height: 1.02;
    margin-bottom: 22px;
    max-width: 14em;
  }
  .hero-intro {
    font-size: 1.15rem;
    color: var(--c-text);
    max-width: 34em;
    margin-bottom: 28px;
  }
  .hero-intro strong { color: var(--c-ink); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }

  /* —— Big slogan strip (full-bleed). Static now; motion comes later. —— */
  .marquee {
    overflow: hidden;
    width: 100%;
    border-top: 1px solid var(--c-border);
    padding-block: 14px;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 34s linear infinite;
  }
  /* pause on hover */
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee__track span {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.4rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--c-slogan);
    white-space: nowrap;
  }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  /* —— section cards (no icon; accent top border; ready for background art later) —— */
  .sections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 28px;
  }
  .section-card {
    display: flex;
    flex-direction: column;
    padding: 26px 28px;
    color: var(--c-text);
    border-top: 3px solid var(--c-border);
  }
  .section-card h3 { margin-bottom: 8px; }
  .section-card p { color: var(--c-muted); font-size: 0.95rem; }
  .section-tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 18px; }
  .tag {
    font-size: 0.75rem;
    color: var(--c-purple);
    background: var(--c-bg-alt);
    border: 1px solid var(--c-border);
    padding: 3px 9px;
    border-radius: 999px;
  }
  .section-link { margin-top: auto; font-weight: 600; font-size: 0.9rem; }

  /* —— recent updates: list —— */
  .updates {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    border-top: 1px solid var(--c-border);
  }
  .update-row {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 6px;
    border-bottom: 1px solid var(--c-border);
    color: var(--c-text);
    transition: background 0.15s ease;
  }
  .update-row:hover { background: var(--c-bg-alt); }
  .update-tag {
    flex: 0 0 auto;
    min-width: 96px;
    text-align: center;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .update-title { flex: 1 1 auto; font-weight: 600; color: var(--c-ink); }
  .update-date { flex: 0 0 auto; font-size: 0.85rem; color: var(--c-muted); }
  .latest-note { color: var(--c-muted); font-size: 0.85rem; margin-top: 18px; }

  /* —— responsive —— */
  @media (max-width: 900px) {
    .hero-inner { padding-block: 52px 40px; }
    .sections-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .update-row { flex-wrap: wrap; gap: 8px 12px; }
    .update-date { width: 100%; }
  }
</style>
